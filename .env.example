# 복사해서 .env로 만들고 값을 넣는다. .env는 커밋하지 않는다.

# 공공데이터포털 일반 인증키(Decoding). 기상청 ASOS 시간자료, 단기예보 조회서비스에 씀
DATA_GO_KR_SERVICE_KEY=

# 서울 열린데이터광장 일반 인증키. 따릉이 실시간 대여정보(bikeList)에 씀
SEOUL_OPEN_API_KEY=

# 서비스용 PostgreSQL (docker compose up -d db). 로컬 개발용 기본값
POSTGRES_USER=bike
POSTGRES_PASSWORD=bike
POSTGRES_DB=bike_demand
POSTGRES_PORT=55452
DATABASE_URL=postgresql+psycopg://bike:bike@localhost:55452/bike_demand
